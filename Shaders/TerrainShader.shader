				float4 temp_output_2_0_g39 = RGBA4_g38;
				

				float3 BaseColor = (temp_output_2_0_g39).xyz;
				float3 Normal = Normal4_g38;
				float3 Specular = 0.5;
				float Metallic = 0;
				float Smoothness = 0.5;
				float Occlusion = 1;
				float3 Emission = 0;
